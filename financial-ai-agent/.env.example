# ===============================================
# Financial AI Agent - Environment Variables
# ===============================================

# Application
APP_NAME="Financial AI Agent"
APP_ENV=development
DEBUG=true
API_HOST=0.0.0.0
API_PORT=8000

# Database
DATABASE_URL=sqlite+aiosqlite:///./data/financial_agent.db
# Para PostgreSQL:
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/financial_agent

# Redis (Cache)
REDIS_URL=redis://localhost:6379/0

# LLM Configuration
# Suporta: openai, anthropic, azure, ollama, etc via LiteLLM
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=4096

# API Keys
OPENAI_API_KEY=sk-your-openai-key
ANTHROPIC_API_KEY=sk-ant-your-anthropic-key

# Para usar modelos locais (Ollama)
# OLLAMA_BASE_URL=http://localhost:11434

# Embeddings
EMBEDDING_MODEL=text-embedding-3-small
# Para embeddings locais:
# EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Vector Store
VECTOR_STORE_TYPE=chroma
VECTOR_STORE_PATH=./data/vectors
# Para Qdrant:
# VECTOR_STORE_TYPE=qdrant
# QDRANT_HOST=localhost
# QDRANT_PORT=6333

# LangFuse (Observability)
LANGFUSE_ENABLED=true
LANGFUSE_PUBLIC_KEY=pk-lf-your-public-key
LANGFUSE_SECRET_KEY=sk-lf-your-secret-key
LANGFUSE_HOST=https://cloud.langfuse.com
# Para LangFuse local:
# LANGFUSE_HOST=http://localhost:3000

# Security
SECRET_KEY=your-super-secret-key-change-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=30

# RAG Configuration
RAG_CHUNK_SIZE=1000
RAG_CHUNK_OVERLAP=200
RAG_TOP_K=5
